{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "alt",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "⊙ : Simply. Sisyphus. p11 on work ..."
    },
    "break",
    {
      "type": "separator",
      "string": "╭────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│   OS",
      "keyColor": "yellow",
      "format": "{3}"
    },
    {
      "type": "kernel",
      "key": "│   Ядро",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ 󰏖  Пакеты",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "│ 󰹑  Монитор",
      "keyColor": "yellow",
      "text": "echo 'Huawei MateView GT 34”, 3440x1440 3K 165Hz'"
    },
    {
      "type": "terminal",
      "key": "│   Терминал",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "│ 󱍜  WM",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "│ 󰉼  GNOME",
      "keyColor": "yellow"
    },
    {
      "type": "separator",
      "string": "╰────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "title",
      "format": " : \u001b[1m{user-name}@{host-name}\u001b[0m",
      "keyColor": "38;2;195;221;225"
    },
    "break",
    {
      "type": "separator",
      "string": "╭────────────────────────────────────────╮"
    },
    {
      "type": "command",
      "key": "│ 󰌢  Mobo",
      "keyColor": "38;2;195;221;225",
      "text": "echo 'Gigabyte AORUS ELITE B650 AM5'"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛  CPU",
      "keyColor": "38;2;195;221;225",
      "format": "{1} ({3}/{4})"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  GPU",
      "keyColor": "38;2;195;221;225",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "command",
      "key": "│ 󰢮  Mesa",
      "keyColor": "38;2;195;221;225",
      "text": "glxinfo 2>/dev/null | grep -oP 'Mesa \\K[\\d.]+' | head -1"
    },
    {
      "type": "memory",
      "key": "│   Память",
      "keyColor": "38;2;195;221;225"
    },
    {
      "type": "command",
      "key": "│ 󱦟  Этой ОС",
      "keyColor": "38;2;195;221;225",
      "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(( (now - birth) / 86400 )) дня"
    },
    {
      "type": "uptime",
      "key": "│ 󱤦  Uptime",
      "keyColor": "38;2;195;221;225"
    },
    {
      "type": "separator",
      "string": "╰────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "circle"
    }
  ]
}
